{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Maravian Sockets Documentation",
  "entryPoints": [
    "packages/types/src/index.ts",
    "packages/server/src/index.ts",
    "packages/sdk/src/index.tsx",
    "packages/cli/src/index.ts"
  ],
  "entryPointStrategy": "expand",
  "exclude": [
    "**/node_modules/**",
    "**/apps/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**"
  ],
  "tsconfig": "tsconfig.docs.json",
  "out": "docs/generated",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "README.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "categorizeByGroup": true,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Types",
    "SDK",
    "Server", 
    "CLI",
    "*"
  ],
  "sort": ["source-order"],
  "kindSortOrder": [
    "Document",
    "Project",
    "Module",
    "Namespace",
    "Enum",
    "EnumMember",
    "Class",
    "Interface",
    "TypeAlias",
    "Constructor",
    "Property",
    "Variable",
    "Function",
    "Method",
    "Accessor"
  ],
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "githubPages": true,
  "gitRevision": "main",
  "gitRemote": "origin",
  "sourceLinkTemplate": "https://github.com/yourusername/maravian-sockets/blob/{gitRevision}/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "searchInComments": true,
  "searchInDocuments": true,
  "treatWarningsAsErrors": false,
  "treatValidationWarningsAsErrors": false,
  "cleanOutputDir": true,
  "hideGenerator": false,
  "disableSources": false,
  "basePath": ".",
  "excludeTags": ["@internal", "@private"],
  "blockTags": [
    "@alpha",
    "@beta",
    "@deprecated",
    "@example",
    "@experimental",
    "@internal",
    "@override",
    "@param",
    "@private",
    "@public",
    "@readonly",
    "@remarks",
    "@returns",
    "@sealed",
    "@see",
    "@since",
    "@throws",
    "@version"
  ],
  "modifierTags": [
    "@alpha",
    "@beta",
    "@deprecated",
    "@experimental",
    "@internal",
    "@override",
    "@private",
    "@public",
    "@readonly",
    "@sealed"
  ]
}
