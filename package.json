{
  "name": "maravian-sockets",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:packages": "node scripts/build.js --skip-docs",
    "build:clean": "node scripts/build.js --skip-clean",
    "build:fast": "node scripts/build.js --skip-clean --skip-tests",
    "test": "node scripts/build.js --docs-only --skip-clean",
    "dev": "pnpm run dev:server",
    "start": "pnpm run start:server",
    "dev:server": "pnpm --filter @maravian/maravian-sockets-server run dev",
    "start:server": "pnpm --filter @maravian/maravian-sockets-server run start",
    "build:server": "pnpm --filter @maravian/maravian-sockets-server run build",
    "dev:dashboard": "pnpm --filter @maravian/maravian-sockets-dashboard run dev",
    "build:dashboard": "pnpm --filter @maravian/maravian-sockets-dashboard run build",
    "preview:dashboard": "pnpm --filter @maravian/maravian-sockets-dashboard run preview",
    "dev:chat-demo": "pnpm --filter @maravian/maravian-sockets-chat-demo run dev",
    "build:chat-demo": "pnpm --filter @maravian/maravian-sockets-chat-demo run build",
    "start:chat-demo": "pnpm --filter @maravian/maravian-sockets-chat-demo run start",
    "format": "node -e \"console.log('format placeholder')\"",
    "docs:generate": "node scripts/docs-build.js",
    "docs:generate:version": "node scripts/docs-build.js --version",
    "docs:clean": "rimraf docs/generated",
    "docs:serve": "pnpm run docs:generate && cd docs/generated && python -m http.server 8000",
    "docs:dev": "pnpm --filter @maravian/maravian-sockets-docs run dev",
    "docs:build": "pnpm run docs:generate && pnpm --filter @maravian/maravian-sockets-docs run build",
    "docs:start": "pnpm --filter @maravian/maravian-sockets-docs run start"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@9.7.0",
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typedoc": "^0.28.12",
    "typedoc-plugin-markdown": "^4.8.1"
  }
}
