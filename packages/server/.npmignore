# Environment files - NEVER publish these
.env
.env.*

# Database files - contain sensitive data
data/
*.db
*.db-wal
*.db-shm

# Development files
src/
*.ts
!dist/**/*.d.ts
tsconfig.json

# Node modules and package manager files
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# Build and development artifacts
.next/
.vite/
coverage/
.nyc_output/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
